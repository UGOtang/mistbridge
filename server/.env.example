# Local development only. Production uses deploy/.env.example (see README).
PORT=4000
DATA_DIR=./data
PUBLIC_BASE_URL=http://127.0.0.1:5173
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
COOKIE_SECURE=0
SESSION_TTL_HOURS=12
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password
FRP_AUTH_TOKEN=replace-with-a-random-frp-token
FRP_PLUGIN_SECRET=replace-with-a-random-plugin-path-secret
APP_ENCRYPTION_KEY=replace-with-base64-encoded-32-bytes
FRP_SERVER_ADDR=127.0.0.1
FRP_CONTROL_PORT=23333
PUBLIC_PORT_MIN=21000
PUBLIC_PORT_MAX=21999
FRP_VERSION=0.72.0
DOWNLOAD_BASE_URL=http://127.0.0.1:5173/downloads
TZ=Asia/Shanghai
